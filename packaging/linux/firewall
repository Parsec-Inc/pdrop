#!/bin/sh
# Abre (open) ou fecha (close) as portas do pdrop no firewall ativo: firewalld ou ufw.
action=${1:?uso: firewall open|close}
if command -v firewall-cmd >/dev/null 2>&1 && firewall-cmd --state >/dev/null 2>&1; then
    # o reload carrega o pdrop.xml recém-instalado; depois vale na hora e após reiniciar
    firewall-cmd --reload >/dev/null 2>&1 || true
    flag=$([ "$action" = open ] && echo --add-service=pdrop || echo --remove-service=pdrop)
    firewall-cmd --permanent "$flag" >/dev/null 2>&1 || true
    firewall-cmd "$flag" >/dev/null 2>&1 || true
fi
if command -v ufw >/dev/null 2>&1 && ufw status 2>/dev/null | grep -q "Status: active"; then
    if [ "$action" = open ]; then
        ufw allow pdrop >/dev/null 2>&1 || true
    else
        ufw delete allow pdrop >/dev/null 2>&1 || true
    fi
fi
exit 0
