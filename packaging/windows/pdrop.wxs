<?xml version="1.0" encoding="utf-8"?>
<!-- Compila com WiX 3 (candle/light, no CI do Windows) ou com wixl (msitools, no Linux).
     Variáveis: Version (x.y.z) e Exe (caminho do pdrop.exe). -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="pdrop" Language="1033" Version="$(var.Version)" Manufacturer="Parsec-Inc"
           UpgradeCode="6B1F3E52-8C4D-4A7B-9E10-2D5A7C9F4B31">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine" Platform="x64"
             Description="pdrop: compartilhe arquivos, texto e clipboard na rede local" />
    <MajorUpgrade DowngradeErrorMessage="Uma versão mais nova do pdrop já está instalada." />
    <Media Id="1" Cabinet="pdrop.cab" EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="pdrop" />
      </Directory>
      <Directory Id="ProgramMenuFolder" />
    </Directory>

    <DirectoryRef Id="INSTALLDIR">
      <Component Id="MainExe" Guid="*" Win64="yes">
        <File Id="PdropExe" Name="pdrop.exe" Source="$(var.Exe)" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <DirectoryRef Id="ProgramMenuFolder">
      <Component Id="MenuShortcut" Guid="*" Win64="yes">
        <Shortcut Id="PdropShortcut" Name="pdrop" Target="[INSTALLDIR]pdrop.exe" WorkingDirectory="INSTALLDIR" />
        <RegistryValue Root="HKCU" Key="Software\Parsec-Inc\pdrop" Name="shortcut" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </DirectoryRef>

    <Feature Id="Main" Title="pdrop" Level="1">
      <ComponentRef Id="MainExe" />
      <ComponentRef Id="MenuShortcut" />
    </Feature>
  </Product>
</Wix>
